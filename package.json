{
  "name": "dsh-video-tools",
  "version": "0.2.0",
  "description": "Cordis Video Generation tools with default LTX distilled and explicit HQ model selection.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "patches",
    "lib/*.js",
    "lib/*.py"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/averyjohnkucan-arch/dsh-video-tools.git"
  },
  "homepage": "https://github.com/averyjohnkucan-arch/dsh-video-tools#readme",
  "bugs": {
    "url": "https://github.com/averyjohnkucan-arch/dsh-video-tools/issues"
  }
}
